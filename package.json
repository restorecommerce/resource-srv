{
  "name": "@restorecommerce/resource-srv",
  "version": "1.5.1",
  "description": "Restore Commerce Resource Microservice",
  "main": "dist/start.cjs",
  "author": "n-fuse GmbH",
  "repository": {
    "type": "git",
    "url": "https://github.com/restorecommerce/resource-srv.git"
  },
  "license": "MIT",
  "keywords": [
    "restore",
    "commerce",
    "microservice",
    "resource"
  ],
  "type": "module",
  "dependencies": {
    "@restorecommerce/acs-client": "^3.5.2",
    "@restorecommerce/grpc-client": "^2.3.4",
    "@restorecommerce/kafka-client": "^1.4.6",
    "@restorecommerce/logger": "^1.4.4",
    "@restorecommerce/rc-grpc-clients": "^5.2.6",
    "@restorecommerce/resource-base-interface": "^1.10.11",
    "@restorecommerce/service-config": "^1.2.4",
    "redis": "6.3.1",
    "remeda": "2.61.0"
  },
  "devDependencies": {
    "@alenon/grpc-mock-server": "^3.2.9",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@grpc/proto-loader": "^0.8.1",
    "@restorecommerce/dev": "^0.3.3",
    "@restorecommerce/protos": "^6.18.1",
    "@semantic-release-plus/docker": "^3.1.3",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.4",
    "should": "^13.2.3"
  },
  "scripts": {
    "start": "node ./dist/start.cjs",
    "dev": "cross-env NODE_ENV=development nodemon --watch './src/**/*.ts' --exec node --loader ts-node/esm ./src/start.ts",
    "pretest": "eslint src",
    "test": "vitest run",
    "prebuild": "rimraf dist lib coverage",
    "build": "node ./esbuild.mjs",
    "postbuild": "cp ./node_modules/@platformatic/wasm-utils/dist/native.wasm dist/",
    "prepare": "node -e \"try { require('husky').install() } catch (e) {}\""
  },
  "engines": {
    "node": ">= 26"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      [
        "@semantic-release-plus/docker",
        {
          "name": "docker.io/restorecommerce/resource-srv",
          "skipLogin": true
        }
      ],
      [
        "@semantic-release-plus/docker",
        {
          "name": "ghcr.io/restorecommerce/resource-srv",
          "skipLogin": true
        }
      ]
    ]
  }
}
